{
  "name": "agenthub-sidecar",
  "private": true,
  "version": "0.1.0",
  "description": "AgentHub's Node.js sidecar: runs the Claude Agent SDK and the GitHub Copilot SDK over JSON-RPC on stdio.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "postinstall": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@github/copilot-sdk": "1.0.26"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
